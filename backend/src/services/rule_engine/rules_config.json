{
  "panel_expectations": {
    "front": ["mrp", "net_quantity", "generic_name"],
    "back": ["manufacturer_name_address", "mfg_date", "consumer_care"],
    "neck": ["mfg_date"]
  },
  "rules": [
    {
      "rule_id": "LM_MRP",
      "field": "mrp",
      "label": "Maximum Retail Price",
      "mandatory": true,
      "regex_patterns": ["₹\\s?\\d+(\\.\\d{1,2})?", "Rs\\.?\\s?\\d+(\\.\\d{1,2})?", "MRP\\s?:?\\s?(₹|Rs\\.?)?\\s?\\d+"],
      "must_contain_phrase": ["inclusive of all taxes", "incl. of all taxes", "incl of taxes", "incl. of taxes"],
      "legal_reference": "Rule 6(1)(f), Legal Metrology (Packaged Commodities) Rules 2011"
    },
    {
      "rule_id": "LM_NET_QTY",
      "field": "net_quantity",
      "label": "Net Quantity",
      "mandatory": true,
      "regex_patterns": ["\\d+\\s?(g|kg|ml|l|litre|liter|gram|gm)\\b"],
      "legal_reference": "Rule 6(1)(c)"
    },
    {
      "rule_id": "LM_MFG_DATE",
      "field": "mfg_date",
      "label": "Month and Year of Manufacture/Packing",
      "mandatory": true,
      "regex_patterns": ["(0[1-9]|1[0-2])[/-]\\d{2,4}", "\\b(Jan|Feb|Mar|Apr|May|Jun|Jul|Aug|Sep|Oct|Nov|Dec)[a-z]*\\.?\\s?\\d{4}\\b"],
      "legal_reference": "Rule 6(1)(d)"
    },
    {
      "rule_id": "LM_MANUFACTURER",
      "field": "manufacturer_name_address",
      "label": "Manufacturer/Packer/Importer Name & Address",
      "mandatory": true,
      "regex_patterns": ["(Mfd|Manufactured|Marketed|Packed)\\s?by[:\\s]", "Mfg\\.?\\s?By"],
      "legal_reference": "Rule 6(1)(a)"
    },
    {
      "rule_id": "LM_CONSUMER_CARE",
      "field": "consumer_care",
      "label": "Consumer Care Details",
      "mandatory": true,
      "regex_patterns": ["(customer|consumer)\\s?care", "[\\w.+-]+@[\\w-]+\\.[a-z]{2,}", "\\b\\d{10}\\b", "toll[- ]?free"],
      "legal_reference": "Rule 6(1)(f)"
    },
    {
      "rule_id": "LM_GENERIC_NAME",
      "field": "generic_name",
      "label": "Common/Generic Name of Commodity",
      "mandatory": true,
      "regex_patterns": [],
      "note": "Hard to regex-match reliably — mark low confidence by default, always route to human review unless product category is pre-selected by officer",
      "legal_reference": "Rule 6(1)(b)"
    },
    {
      "rule_id": "LM_COUNTRY_ORIGIN",
      "field": "country_of_origin",
      "label": "Country of Origin (for imports only)",
      "mandatory": false,
      "regex_patterns": ["country of origin", "made in [a-z]+", "product of [a-z]+"],
      "legal_reference": "Rule 6(1)(a) — applicable to imported commodities and per 2026 e-commerce amendments"
    }
  ]
}
