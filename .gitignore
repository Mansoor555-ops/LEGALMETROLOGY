# Environment & API Key Secrets (CRITICAL SECURITY PROTECTION)
.env
.env.*
*.env
backend/.env
frontend/.env.local
frontend/.env.production
frontend/.env.development

# Dependencies
node_modules/
backend/venv/
backend/venv*/

# Next.js
frontend/.next/
frontend/out/

# Python & Cache
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/

# User Uploads, Generated PDF Reports & FAISS Scratch Data
backend/uploads/*
!backend/uploads/.gitkeep
backend/reports/*
!backend/reports/.gitkeep
backend/data/*
!backend/data/.gitkeep
backend/faiss_index/*
!backend/faiss_index/.gitkeep
backend/scratch/

# SQLite & Logs
*.db
*.log

# System & IDE
.DS_Store
*.swp
.vercel
